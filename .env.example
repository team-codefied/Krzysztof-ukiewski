# --- Contact form (Resend) -------------------------------------------------
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where messages are delivered. Defaults to the address below if omitted.
CONTACT_TO_EMAIL=krzysztoflukiewski@gmail.com

# Sender address. "onboarding@resend.dev" works for testing only when the
# Resend account owner's email is the recipient. For production, verify a domain
# in Resend and use e.g.  The World That Could Be <contact@yourdomain.com>
CONTACT_FROM_EMAIL=The World That Could Be <onboarding@resend.dev>

# --- Site -------------------------------------------------------------------
# Canonical production URL (used for metadata, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Social links (not supplied yet; icons stay inactive until set) ----------
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
